{
  "name": "liftit",
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run test && npm run build",
    "cf:dev": "npm run build && wrangler pages dev",
    "cf:deploy": "npm run build && wrangler pages deploy",
    "cf:db:create": "wrangler d1 create liftit",
    "cf:db:migrate": "wrangler d1 execute liftit --remote --file=./schema.sql",
    "cf:db:migrate:local": "wrangler d1 execute liftit --local --file=./schema.sql",
    "cf:tail": "wrangler pages deployment tail",
    "server": "cd server && npm run dev",
    "server:build": "cd server && npm run build",
    "dev:all": "npm run server & npm run dev",
    "db:push": "cd server && npx prisma db push",
    "db:seed": "cd server && npx prisma db seed",
    "db:studio": "cd server && npx prisma studio",
    "ios:init": "npx cap add ios",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "keywords": [
    "fitness",
    "workout",
    "tracker",
    "ai",
    "progressive-overload",
    "ios",
    "pwa"
  ],
  "author": "",
  "license": "ISC",
  "description": "AI-powered fitness tracker with progressive overload guidance",
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "axios": "^1.19.0",
    "clsx": "^2.1.1",
    "hono": "^4.13.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^6.30.4",
    "recharts": "^2.12.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^9.39.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.4",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "undici": "^7.29.0"
  }
}
