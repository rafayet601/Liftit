# ──────────────────────────────────────────────
# Liftit — Docker Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# API Configuration (for local dev without Docker)
VITE_API_URL=http://localhost:3001/api

# ── Database ──
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=liftit
MYSQL_PASSWORD=liftitpass

# ── Auth (REQUIRED) ──
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=7d

# ── Frontend URL (used for CORS + OAuth redirects) ──
FRONTEND_URL=http://localhost

# ── Google OAuth (optional) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost/api/auth/google/callback

# ── GitHub OAuth (optional) ──
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost/api/auth/github/callback

# ── AI Providers (optional) ──
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
